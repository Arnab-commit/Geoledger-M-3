# GeoLedger Environment Configuration
# Copy this file to .env and update the values

# Application
APP_NAME=GeoLedger
APP_VERSION=0.1.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Local/demo: SQLite (default)
DATABASE_URL=sqlite:///./data/geoldger.db
# Production: set DATABASE_URL to a postgresql+psycopg URL in a protected .env
# file or secret manager. Never commit database credentials.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
# SEED_DEMO_DATA is inferred: enabled for SQLite, disabled for PostgreSQL.
# Set SEED_DEMO_DATA=true only in a disposable local/demo database.

# File Storage
UPLOAD_DIR=uploads
ORIGINAL_DIR=uploads/originals
PROCESSED_DIR=uploads/processed
MAX_FILE_SIZE_MB=50

# Authentication
# IMPORTANT: Change SECRET_KEY in production!
SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-geoldger-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# OCR Configuration
OCR_PROVIDER=local
# OCR_PROVIDER=tesseract  # When Tesseract is available
# OCR_PROVIDER=paddleocr  # When PaddleOCR is available
TESSERACT_PATH=
OCR_LANGUAGES=eng,hin

# Processing Confidence Thresholds
MIN_OCR_CONFIDENCE=0.3
LOW_CONFIDENCE_THRESHOLD=0.6
HIGH_CONFIDENCE_THRESHOLD=0.85

# CORS (comma-separated origins)
CORS_ORIGINS=*
